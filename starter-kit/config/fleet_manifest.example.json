{
  "_comment": "Copy to config/fleet_manifest.json. Names are yours to choose. Describe each node by ROLE. MAC addresses are the stable identity; addresses are only a last resort.",
  "heartbeat_dir": "state/heartbeats",
  "heartbeat_max_age_min": 15,
  "wol_broadcast": "<LAN broadcast address, e.g. the .255 of your subnet>",
