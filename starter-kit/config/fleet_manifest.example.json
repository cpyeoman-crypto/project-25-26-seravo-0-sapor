      "probe_port": 22,
      "wake_required": false
    },
    {
      "name": "edge-scout-1",
      "role": "Edge scout / console",
      "macs": ["<aa:bb:cc:dd:ee:02>"],
      "mesh_name": "<hostname on your mesh overlay>",
      "probe_port": 22,
      "wake_required": true
    },
    {
      "name": "windows-hub",
      "role": "Windows hub",
      "macs": ["<aa:bb:cc:dd:ee:03>"],
      "mesh_name": "<hostname on your mesh overlay>",
      "probe_port": 22,
      "wake_required": true,
      "last_known_address": "<optional, lowest trust>"
    },
    {
      "name": "travel-medic",
      "role": "Mobile Linux client",
      "macs": ["<aa:bb:cc:dd:ee:04>"],
