# Copy to config/fleet.env and fill in. Never commit the real file (it is git-ignored).
# PUBLIC NON-OPERATIONAL EXAMPLE: private identifiers use x placeholders.
# Keep NTFY_TOPIC empty here to prevent sending; set a private value only in fleet.env.
# A long random topic name is your only access control on the public ntfy.sh server.
# Generate one with:  python3 -c "import secrets; print('mynet-' + secrets.token_urlsafe(18))"
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Only needed for a self-hosted or access-controlled ntfy server:
# NTFY_TOKEN=
# Private token placeholder (not an assignment): x-token
SITE_NAME=my-network
