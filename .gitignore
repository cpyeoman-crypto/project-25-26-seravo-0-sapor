# keep structure, ignore real archive content
archive/*.md
archive/transcripts/*.jsonl
!archive/.gitkeep
!archive/transcripts/.gitkeep
.env
*.key

starter-kit/config/fleet.env
starter-kit/config/fleet_manifest.json
starter-kit/config/maintenance.json
starter-kit/state/*
!starter-kit/state/.gitkeep
starter-kit/fleet-kit.zip
__pycache__/
